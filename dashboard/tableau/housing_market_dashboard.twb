      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Calculation_0481014088024066:nk]' type='palette'>
            <map to='#bab0ac'>
              <bucket>&quot;Other&quot;</bucket>
            </map>
            <map to='#f28e2b'>
