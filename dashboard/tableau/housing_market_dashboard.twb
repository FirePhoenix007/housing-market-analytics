      <aliases enabled='yes' />
      <column caption='PSF Outlier Flag' datatype='string' name='[Calculation_0481014085181440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [price_per_sqft] &gt; 12057 OR [price_per_sqft] &lt; 500 THEN &quot;Outlier&quot; ELSE &quot;Normal&quot; END' />
      </column>
      <column caption='Top 15 Locality' datatype='string' name='[Calculation_0481014087147521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [locality_standard] IN (&quot;HAL 2nd Stage&quot;,&quot;Cunningham Road&quot;,&quot;Sadashiva Nagar&quot;,&quot;Giri Nagar&quot;,&quot;2nd Stage Nagarbhavi&quot;,&quot;Benson Town&quot;,&quot;BTM 1st Stage&quot;,&quot;Rajaji Nagar&quot;,&quot;Mahalakshmi Layout&quot;,&quot;Thyagaraja Nagar&quot;,&quot;Basaveshwara Nagar&quot;,&quot;Malleshwaram&quot;,&quot;1st Block Jayanagar&quot;,&quot;Dairy Circle&quot;,&quot;Indira Nagar&quot;) THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
      </column>
      <column caption='Highlight Top Locality' datatype='string' name='[Calculation_0481014088024066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [locality_standard] = &quot;HAL 2nd Stage&quot; THEN &quot;#1 Locality&quot; ELSE &quot;Other&quot; END' />
      </column>
      <column caption='Highlight 4BHK Jump' datatype='string' name='[Calculation_0481014088507395]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bhk_category] = &quot;4 BHK&quot; THEN &quot;Steepest Jump&quot; ELSE &quot;Other&quot; END' />
      </column>
      <column caption='Size Band' datatype='string' name='[Calculation_0481014857805828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [size_bucket]=&quot;&lt;500 sqft&quot; THEN &quot;1 | &lt;500&quot; ELSEIF [size_bucket]=&quot;500-1000 sqft&quot; THEN &quot;2 | 500-1000&quot; ELSEIF [size_bucket]=&quot;1000-1500 sqft&quot; THEN &quot;3 | 1000-1500&quot; ELSEIF [size_bucket]=&quot;1500-2500 sqft&quot; THEN &quot;4 | 1500-2500&quot; ELSE &quot;5 | 2500+&quot; END' />
      </column>
      <column caption='Cell Has 20 Listings' datatype='boolean' name='[Calculation_0481014858375173]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [bhk_category],[Calculation_0481014857805828]: COUNT([price_per_sqft])} &gt;= 20' />
      </column>
      <column caption='K Listings' datatype='integer' name='[Calculation_0481014860124166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([price_per_sqft])' />
      </column>
      <column caption='K Median Price (Lakhs)' datatype='real' name='[Calculation_0481014860238855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([price_lakhs])' />
      </column>
      <column caption='K Median Rs per sqft' datatype='real' name='[Calculation_0481014860263432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([price_per_sqft])' />
      </column>
      <column caption='K Median Size (sqft)' datatype='real' name='[Calculation_0481014860369929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([total_sqft_clean])' />
      </column>
      <column caption='K Localities' datatype='integer' name='[Calculation_0481014860394506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([locality_standard])' />
      </column>
      <column datatype='integer' name='[Price Lakhs (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='1' formula='[price_lakhs]' peg='0' size='74' />
      </column>
      <column caption='housing_cleaned.csv' datatype='table' name='[__tableau_internal_object_id__].[housing_cleaned.csv_1C2374DB082846DB974E28AA80941E2E]' role='measure' type='quantitative' />
